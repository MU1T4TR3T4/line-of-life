# ID da pasta do Google Drive (o final do link da pasta: drive.google.com/drive/folders/<ID>)
DRIVE_FOLDER_ID=

# Conteúdo do arquivo JSON da conta de serviço do Google (pode colar o JSON inteiro ou em base64)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Senha que a família digita para entrar no site
SITE_PASSWORD=
